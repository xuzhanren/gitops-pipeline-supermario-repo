name: "Build and push supermario image, scan image, Update deployment and version txt files"

on:
  push:
    branches:
      - main

jobs:
  build_push_supermario_docker_image:
    runs-on: ubuntu-latest
    # Removed "needs: sonarqube_sast_scan" since it is commented out

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v3

      - name: Calculate Dynamic Version
        id: versioning
        run: |
          # Safely read version or default to 0 if the file doesn't exist
          CURRENT_VERSION=$(cat version.txt 2>/dev/null || echo 0)
          NEW_VERSION=$(( CURRENT_VERSION + 1 ))
          echo "VERSION=$NEW_VERSION" >> $GITHUB_ENV

      - name: Login to Docker Hub
        run: echo "${{ secrets.DOCKERHUB_TOKEN }}" | docker login -u "${{ secrets.DOCKERHUB_USERNAME }}" --password-stdin

      - name: Build and Push Docker Image
        run: |
          docker build -t docker.io/renxuzhan/supermario:${{ env.VERSION }} .
          docker push docker.io/renxuzhan/supermario:${{ env.VERSION }}

  run_container_image_scan_on_supermario_docker_image:
    runs-on: ubuntu-latest
    needs: build_push_supermario_docker_image	

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v3

      - name: Login to Docker Hub
        run: echo "${{ secrets.DOCKERHUB_TOKEN }}" | docker login -u "${{ secrets.DOCKERHUB_USERNAME }}" --password-stdin
        
      - name: Pull Docker Image for Scanning
        run: |
          # Dynamically calculate the version here as well if needed, or pass it using workflow artifacts/outputs
          CURRENT_VERSION=$(cat version.txt 2>/dev/null || echo 0)
          NEW_VERSION=$(( CURRENT_VERSION + 1 ))
          docker pull docker.io/renxuzhan/supermario:$NEW_VERSION
